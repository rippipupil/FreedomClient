{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreedomClient",
  "version": "0.1.0",
  "identifier": "com.freedomclient.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FreedomClient",
        "width": 980,
        "height": 620,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#1A0B2E"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://mc-heads.net; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "FreedomClient Launcher",
    "copyright": "FreedomClient",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
